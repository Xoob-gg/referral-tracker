{
  "name": "@xoob-gg/referral-tracker",
  "version": "1.0.3",
  "description": "Client-side referral tracking script for EVM wallet connections",
  "main": "dist/tracker.min.js",
  "scripts": {
    "build": "esbuild src/tracker.js --bundle --minify --outfile=dist/tracker.min.js",
    "build:dev": "esbuild src/tracker.js --bundle --outfile=dist/tracker.js",
    "watch": "esbuild src/tracker.js --bundle --outfile=dist/tracker.js --watch",
    "serve": "npx serve . -p 3000",
    "dev": "npm run build:dev && npm run serve",
    "test": "echo \"Error: no test specified\" && exit 1",
    "preversion": "pnpm run build",
    "version": "git add dist/",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xoob-gg/referral-tracker.git"
  },
  "keywords": [
    "referral",
    "tracking",
    "wallet",
    "evm",
    "ethereum",
    "web3"
  ],
  "author": "Xoob",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Xoob-gg/referral-tracker/issues"
  },
  "homepage": "https://github.com/Xoob-gg/referral-tracker#readme",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "esbuild": "0.25.10",
    "serve": "14.2.5"
  }
}
